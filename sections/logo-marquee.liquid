{{ 'logo-marquee.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top}}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div
  class="logo-marquee section-{{ section.id }} section-{{ section.id }}-padding {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  data-logo-marquee
  data-section-id="{{ section.id }}"
  data-speed="{{ section.settings.marquee_speed }}"
  data-direction="{{ section.settings.direction }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  data-mobile-enable="{{ section.settings.mobile_enable }}"
  style="
    --section-padding-top: {{ section.settings.section_padding_top }}px;
    --section-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --logo-bg: {{ section.settings.background_color }};
    --logo-height: {{ section.settings.logo_height }}px;
    --logo-width: {{ section.settings.logo_width }}px;
    --logo-gap: {{ section.settings.logo_gap }}px;
  "
>
  <div class="logo-marquee__wrapper">

    {% if section.settings.heading != blank %}
      <div class="logo-marquee__heading">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    <div
      class="logo-marquee__viewport"
      data-marquee-viewport
    >
      <div
        class="logo-marquee__track"
        data-marquee-track
      >
        {% for block in section.blocks %}
          {% assign logo_image = block.settings.logo %}

          <div
            class="logo-marquee__item"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="logo-marquee__link"
                {% if block.settings.open_new_tab %}
                  target="_blank"
                  rel="noopener noreferrer"
                {% endif %}
              >
            {% endif %}

            {% if logo_image != blank %}
              {{
                logo_image
                | image_url: width: 500
                | image_tag:
                  loading: 'lazy',
                  widths: '100,150,200,300,400,500',
                  sizes: 'auto',
                  class: 'logo-marquee__image',
                  alt: logo_image.alt
              }}
            {% else %}
              <div class="logo-marquee__placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</div>

<script src="{{ 'logo-marquee.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Logo Marquee",
  "tag": "section",
  "class": "section-logo-marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F1F3F9"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo area width",
      "min": 100,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 170
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Logo gap",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "default": 35
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_enable",
      "label": "Enable marquee on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 36
    }


  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Logo link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Marquee",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
<div class="prb-wrap" data-prb-root>
  <div class="prb-bar">
    <div class="prb-left">
      <svg class="prb-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="11" fill="#3b5bfd"/>
        <line x1="8" y1="16" x2="16" y2="8" stroke="#fff" stroke-width="1.7" stroke-linecap="round"/>
        <circle cx="9" cy="9" r="1.7" fill="#fff"/>
        <circle cx="15" cy="15" r="1.7" fill="#fff"/>
      </svg>
      <span class="prb-text">{{ prb_text }}</span>
    </div>
    <div class="prb-divider"></div>
    <div class="prb-right">
      <span class="prb-code-label">Use code: <span class="prb-code">{{ prb_code }}</span></span>
      <button type="button" class="prb-copy" data-prb-copy data-code="{{ prb_code }}" aria-label="Copy code">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M5 15V6a2 2 0 012-2h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <span class="prb-msg" data-prb-msg>Copied!</span>
    </div>
  </div>
</div>

<script>
(function(){
  function init(){
    var root = document.querySelector('[data-prb-root]');
    if(!root) return;
    var btn = root.querySelector('[data-prb-copy]');
    var msg = root.querySelector('[data-prb-msg]');
    if(!btn) return;

    btn.addEventListener('click', function(){
      var code = btn.getAttribute('data-code') || '';
      function shown(){
        msg.classList.add('prb-show');
        setTimeout(function(){ msg.classList.remove('prb-show'); }, 1600);
      }
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(code).then(shown).catch(function(){
          fallbackCopy(code); shown();
        });
      } else {
        fallbackCopy(code); shown();
      }
    });

    function fallbackCopy(text){
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try { document.execCommand('copy'); } catch(e){}
      document.body.removeChild(ta);
    }
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();

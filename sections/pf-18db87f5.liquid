<div class="hpc-wrap" data-hpc-root>
  <div class="hpc-row" data-hpc-row>
    {%- liquid
      assign hpc_variants = product.variants
      assign hpc_base_variant = hpc_variants.first
      assign hpc_base_pack = hpc_base_variant.title | split: ' ' | first | times: 1
      if hpc_base_pack == 0
        assign hpc_base_pack = 1
      endif
      assign hpc_base_per_bottle = hpc_base_variant.price | divided_by: hpc_base_pack
    -%}
    {%- for variant in hpc_variants -%}
      {%- liquid
        assign hpc_pack = variant.title | split: ' ' | first | times: 1
        if hpc_pack == 0
          assign hpc_pack = 1
        endif
        assign hpc_per_bottle = variant.price | divided_by: hpc_pack
        assign hpc_ratio = hpc_per_bottle | times: 1.0 | divided_by: hpc_base_per_bottle
        assign hpc_discount = 1.0 | minus: hpc_ratio | times: 100 | round
        assign hpc_badge = ''
        if forloop.index == 2
          assign hpc_badge = 'MOST POPULAR'
        elsif forloop.last and forloop.length > 2
          assign hpc_badge = 'BEST VALUE'
        endif
        assign hpc_img = variant.featured_image | default: product.featured_image
      -%}
      <div class="hpc-card{% if forloop.index == 2 %} hpc-selected{% endif %}{% unless variant.available %} hpc-soldout{% endunless %}"
           data-hpc-card
           data-variant-id="{{ variant.id }}"
           data-price-money="{{ variant.price | money }}"
           data-compare-money="{{ variant.compare_at_price | money }}"
           data-price="{{ variant.price }}"
           data-compare="{{ variant.compare_at_price }}"
           data-available="{{ variant.available }}">
        {%- if hpc_badge != '' -%}<span class="hpc-badge">{{ hpc_badge }}</span>{%- endif -%}
        {%- unless variant.available -%}<span class="hpc-soldout-tag">Sold out</span>{%- endunless -%}
        {%- if hpc_img -%}
          <img class="hpc-img" src="{{ hpc_img | image_url: width: 160 }}" alt="{{ variant.title }}" loading="lazy">
        {%- endif -%}
        <div class="hpc-label">{{ variant.title }}</div>
        {%- if hpc_discount > 0 -%}
          <div class="hpc-discount">{{ hpc_discount }}% off</div>
        {%- else -%}
          <div class="hpc-discount"> </div>
        {%- endif -%}
        <div class="hpc-price">{{ hpc_per_bottle | money }}<span class="hpc-unit">/bottle</span></div>
      </div>
    {%- endfor -%}
  </div>

  <div class="hpc-summary">
    <div class="hpc-summary-row">
      <span class="hpc-summary-price" data-hpc-total></span>
      <span class="hpc-summary-compare" data-hpc-compare></span>
    </div>
    <span class="hpc-summary-label" data-hpc-label></span>
  </div>

  <button type="button" class="hpc-btn" data-hpc-add>Add to Cart</button>
  <div class="hpc-msg" data-hpc-msg></div>
</div>

<script>
(function(){
  function init(){
    var root = document.querySelector('[data-hpc-root]');
    if(!root) return;
    var cards = root.querySelectorAll('[data-hpc-card]');
    var totalEl = root.querySelector('[data-hpc-total]');
    var compareEl = root.querySelector('[data-hpc-compare]');
    var labelEl = root.querySelector('[data-hpc-label]');
    var addBtn = root.querySelector('[data-hpc-add]');
    var msgEl = root.querySelector('[data-hpc-msg]');
    var selected = root.querySelector('.hpc-selected') || cards[0];

    function render(){
      if(!selected) return;
      var priceMoney = selected.getAttribute('data-price-money') || '';
      var compareMoney = selected.getAttribute('data-compare-money') || '';
      var price = parseInt(selected.getAttribute('data-price'), 10) || 0;
      var compare = parseInt(selected.getAttribute('data-compare'), 10) || 0;
      var labelText = (selected.querySelector('.hpc-label') || {}).textContent || '';

      totalEl.textContent = priceMoney;
      labelEl.textContent = labelText;

      if(compare > price){
        compareEl.textContent = compareMoney;
        compareEl.style.display = '';
      } else {
        compareEl.textContent = '';
        compareEl.style.display = 'none';
      }

      var available = selected.getAttribute('data-available') === 'true';
      addBtn.disabled = !available;
      addBtn.textContent = available ? 'Add to Cart' : 'Sold Out';
    }

    cards.forEach(function(card){
      card.addEventListener('click', function(){
        if(card.classList.contains('hpc-soldout')) return;
        cards.forEach(function(c){ c.classList.remove('hpc-selected'); });
        card.classList.add('hpc-selected');
        selected = card;
        render();
      });
    });

    addBtn.addEventListener('click', function(){
      if(!selected) return;
      var variantId = selected.getAttribute('data-variant-id');
      addBtn.disabled = true;
      var originalText = addBtn.textContent;
      addBtn.textContent = 'Adding...';
      msgEl.textContent = '';
      msgEl.className = 'hpc-msg';

      fetch((window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/') + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(variantId,10), quantity: 1 }] })
      })
      .then(function(res){
        if(!res.ok){ return res.json().then(function(d){ throw new Error(d.description || 'Could not add to cart'); }); }
        return res.json();
      })
      .then(function(){
        msgEl.textContent = 'Added to cart.';
        msgEl.className = 'hpc-msg hpc-ok';
        addBtn.disabled = false;
        addBtn.textContent = originalText;
        document.dispatchEvent(new CustomEvent('cart:updated'));
      })
      .catch(function(err){
        msgEl.textContent = err.message || 'Something went wrong.';
        msgEl.className = 'hpc-msg hpc-err';
        addBtn.disabled = false;
        addBtn.textContent = originalText;
      });
    });

    render();
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script></div><div data-pf-type="Custom.HTML" class="sc-fUBjpT dwZasy pf-24_"><style>

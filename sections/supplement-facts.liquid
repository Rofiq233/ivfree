            "amount": "25 MG"
          }
        },


        {
          "type": "ingredient",

          "settings": {
            "ingredient_name": "L-Glycine",
            "amount": "100 MG"
          }
        },


        {
          "type": "ingredient",

          "settings": {
            "ingredient_name": "Hyaluronic Acid",
            "amount": "100 MG"
          }
        },


        {
          "type": "ingredient",

          "settings": {
            "ingredient_name": "Ginger Extract",
            "amount": "100 MG"
          }
        },


        {
          "type": "ingredient",

          "settings": {
            "ingredient_name": "Ginseng",
            "amount": "100 MG"
          }
        },


        {
          "type": "ingredient",


{{ 'supplement-facts.css' | asset_url | stylesheet_tag }}

<section
  id="SupplementFacts-{{ section.id }}"
  class="supplement-facts gradient color-{{ section.settings.section_color_scheme }}"
  style="
    --sf-desktop-height: {{ section.settings.desktop_height }}px;
    --sf-mobile-height: {{ section.settings.mobile_height }}px;
    --sf-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>

  {% if section.settings.background_image != blank %}
    <div
      class="supplement-facts__background"
      style="
        background-image:
          linear-gradient(
            rgba(0, 0, 0, var(--sf-overlay-opacity)),
            rgba(0, 0, 0, var(--sf-overlay-opacity))
          ),
          url('{{ section.settings.background_image | image_url: width: 2400 }}');
      "
    ></div>
  {% endif %}


  <div class="supplement-facts__inner">

    <!-- =================================
         HEADER
    ================================== -->

    <div class="supplement-facts__header">

      {% if section.settings.heading != blank %}
        <h2 class="supplement-facts__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      {% if section.settings.serving_info != blank %}
        <div class="supplement-facts__serving">
          {{ section.settings.serving_info }}
        </div>
      {% endif %}

    </div>



    <!-- =================================
         MAIN CONTENT
    ================================== -->

    <div class="supplement-facts__content">


      <!-- =================================
           INGREDIENTS
      ================================== -->

      <div class="sf-card sf-card--ingredients">

        <div class="sf-card__header sf-card__header--ingredients">

          <div>
            {{ section.settings.ingredients_title }}
          </div>

          <div>
            {{ section.settings.amount_title }}
          </div>

        </div>


        <div class="sf-ingredients-list">

          {% for block in section.blocks %}

            {% if block.type == 'ingredient' %}

              <div
                class="sf-ingredient"
                {{ block.shopify_attributes }}
              >

                <div class="sf-ingredient__name">
                  {{ block.settings.ingredient_name }}
                </div>

                <div class="sf-ingredient__amount">
                  {{ block.settings.amount }}
                </div>

              </div>

            {% endif %}

          {% endfor %}

        </div>

      </div>



      <!-- =================================
           RIGHT SIDE
      ================================== -->

      <div class="sf-card sf-card--right">


        <!-- OTHER INGREDIENTS -->

        <div class="sf-card__header sf-card__header--single">

          {{ section.settings.other_ingredients_title }}

        </div>


        <div class="sf-other-content">

          {% for block in section.blocks %}

            {% if block.type == 'other_ingredient' %}

              <div
                class="sf-other-item"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.text }}
              </div>

            {% endif %}

          {% endfor %}

        </div>



        <!-- DIVIDER -->

        <div class="sf-right-divider"></div>



        <!-- =================================
             HOW TO USE
        ================================== -->

        <div class="sf-how-to-use">

          {% if section.settings.how_to_use_title != blank %}

            <div class="sf-how-to-use__title">
              {{ section.settings.how_to_use_title }}
            </div>

          {% endif %}


          {% if section.settings.how_to_use_description != blank %}

            <div class="sf-how-to-use__description">
              {{ section.settings.how_to_use_description }}
            </div>

          {% endif %}



          <!-- DIVIDER -->

          <div class="sf-how-divider"></div>



          <!-- =================================
               USAGE ITEMS
          ================================== -->

          <div class="sf-usage">

            {% for block in section.blocks %}

              {% if block.type == 'usage_item' %}

                <div
                  class="sf-usage__item"
                  {{ block.shopify_attributes }}
                >


                  <!-- =================================
                       IMAGE / SVG FALLBACK
                  ================================== -->

                  {% if block.settings.image != blank %}

                    <!-- Uploaded Image -->

                    <div class="sf-usage__icon sf-usage__icon--image">

                      {{
                        block.settings.image
                        | image_url: width: 100
                        | image_tag:
                          loading: 'lazy',
                          widths: '50, 75, 100',
                          sizes: '50px',
                          alt: block.settings.title
                      }}

                    </div>


                  {% else %}

                    <!-- SVG FALLBACK -->

                    <div class="sf-usage__icon sf-usage__icon--svg">

                      {% case block.settings.icon %}


                        {% when 'clock' %}

                          <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <circle
                              cx="12"
                              cy="12"
                              r="9"
                            ></circle>

                            <path
                              d="M12 7v5l3 2"
                            ></path>
                          </svg>


                        {% when 'capsule' %}

                          <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <rect
                              x="5"
                              y="8"
                              width="14"
                              height="8"
                              rx="4"
                              transform="rotate(-45 12 12)"
                            ></rect>

                            <path
                              d="M9 15l6-6"
                            ></path>
                          </svg>


                        {% when 'water' %}

                          <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              d="M7 7h10l-1 12H8L7 7Z"
                            ></path>

                            <path
                              d="M9 4h6"
                            ></path>

                            <path
                              d="M9 11c2 1 4 1 6 0"
                            ></path>
                          </svg>


                        {% when 'calendar' %}

                          <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <rect
                              x="4"
                              y="5"
                              width="16"
                              height="15"
                              rx="2"
                            ></rect>

                            <path
                              d="M8 3v4"
                            ></path>

                            <path
                              d="M16 3v4"
                            ></path>

                            <path
                              d="M4 9h16"
                            ></path>

                            <path
                              d="m9 15 2 2 4-4"
                            ></path>
                          </svg>


                      {% endcase %}

                    </div>

                  {% endif %}



                  <!-- =================================
                       TITLE
                  ================================== -->

                  {% if block.settings.title != blank %}

                    <div class="sf-usage__title">
                      {{ block.settings.title }}
                    </div>

                  {% endif %}



                  <!-- =================================
                       DESCRIPTION
                  ================================== -->

                  {% if block.settings.description != blank %}

                    <div class="sf-usage__description">
                      {{ block.settings.description }}
                    </div>

                  {% endif %}


                </div>

              {% endif %}

            {% endfor %}

          </div>

        </div>

      </div>

    </div>

  </div>

</section>






{% schema %}

{
  "name": "Supplement Facts",

  "tag": "section",

  "class": "section-supplement-facts",


  "settings": [

    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },


    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop background height",
      "min": 400,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 650
    },


    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile background height",
      "min": 500,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 950
    },


    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 15
    },


    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Supplements Facts"
    },

 {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },

    {
      "type": "text",
      "id": "serving_info",
      "label": "Serving information",
      "default": "Serving per container: 30  Serving Size: 1 Tablet"
    },


    {
      "type": "text",
      "id": "ingredients_title",
      "label": "Ingredients heading",
      "default": "INGREDIENTS"
    },


    {
      "type": "text",
      "id": "amount_title",
      "label": "Amount heading",
      "default": "AMOUNT PER SERVING"
    },


    {
      "type": "text",
      "id": "other_ingredients_title",
      "label": "Other ingredients heading",
      "default": "OTHER INGREDIENTS"
    },


    {
      "type": "text",
      "id": "how_to_use_title",
      "label": "How to use label",
      "default": "HOW TO USE"
    },


    {
      "type": "textarea",
      "id": "how_to_use_description",
      "label": "How to use description",
      "default": "Take one tablet daily after breakfast or lunch or as directed by your healthcare practitioner."
    },

       {
              "type": "color_scheme",
              "id": "section_color_scheme",
              "label": "Scheme"
            }
  ],



  "blocks": [


    {
      "type": "ingredient",

      "name": "Ingredient",

      "settings": [

        {
          "type": "text",
          "id": "ingredient_name",
          "label": "Ingredient name",

          "default": "CoQ10"
        },


        {
          "type": "text",
          "id": "amount",
          "label": "Amount",

          "default": "100 MG"
        }

      ]
    },



    {
      "type": "other_ingredient",

      "name": "Other ingredient",

      "settings": [

        {
          "type": "richtext",
          "id": "text",
          "label": "Content",

          "default": "<p>Magnesium Stearate, CMC (Carboxymethyl Cellulose) and Dextrin.</p>"
        }

      ]
    },



    {
      "type": "usage_item",

      "name": "Usage item",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon / Image",
          "info": "Upload an image. If empty, the selected SVG icon will be shown."
        },


        {
          "type": "select",
          "id": "icon",
          "label": "Default SVG icon",

          "options": [

            {
              "value": "clock",
              "label": "Clock"
            },

            {
              "value": "capsule",
              "label": "Capsule"
            },

            {
              "value": "water",
              "label": "Water"
            },

            {
              "value": "calendar",
              "label": "Calendar"
            }

          ],

          "default": "clock"
        },


        {
          "type": "text",
          "id": "title",
          "label": "Title",

          "default": "After breakfast or lunch"
        },


        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }

      ]

    }

  ],



  "presets": [

    {
      "name": "Supplement Facts",

      "blocks": [


        {
          "type": "ingredient",

          "settings": {
            "ingredient_name": "β-Nicotinamide Mononucleotide (Decode Age® NMN)",

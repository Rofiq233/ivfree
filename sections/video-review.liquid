          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
       {
      "type": "header",
      "content": "Settings"
            },
            {
            "type": "checkbox",
            "id": "autoplay_enabled",
            "label": "Auto play",
            "default": false
            },
            {
            "type": "range",
            "id": "autoplay_timeout",
            "label": "Auto paly time",
            "min": 1,
            "max": 10,
            "step": 1,
            "default": 5,
            "unit": "s"
            },
          
            {
            "type": "checkbox",
            "id": "loop_enabled",
            "label": "Loop",
            "default": false
            },
            {
                "type": "checkbox",
                "id": "enable_navigation",
                "label": "Navigation"
            },
            {
                "type": "checkbox",
                "id": "scrollbar",
                "label": "Scroll Bar"
            },
            {
            "type": "header",
            "content": "Card"
            },
            {
            "type": "select",
            "id": "desktop_grid",
            "label": "Desktop",
            "options": [
                {
                "label": "2",
                "value": "2"
                },
                {
                "label": "3",
                "value": "3"
                },
                {
                "label": "4",
                "value": "4"
                },
                {
                "label": "5",
                "value": "5"
                }
            ],
            "default": "4"
            },

            {
            "type": "select",
            "id": "tab_grid",
            "label": "Tablet",
            "options": [
                {
                "label": "1",
                "value": "1"
                },
                {
                "label": "2",
                "value": "2"
                },
                {
                "label": "3",
                "value": "3"
                },
                {
                "label": "4",
                "value": "4"
                }
            ],
            "default": "4"
            },

            {
            "type": "select",
            "id": "mobile_grid",
            "label": "Mobile",
            "options": [
                {
                "label": "1",
                "value": "1"
                },
                {
                "label": "1.2",
                "value": "1.2"
                },
                {
                "label": "2",
                "value": "2"
                }
            ],
            "default": "1"
            },
            {
              "type": "color_scheme",
              "id": "section_color_scheme",
              "label": "Scheme"
            }
            ,
             {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 36
    }
           
    ],
    "blocks": [
        {
            "type": "Item",
            "name":"Item",
            "settings": [
                 {
                "type": "select",
                "id": "source",
                "label": "Source",
                "default": "uploaded",
                "options": [
                    {
                    "value": "external",
                    "label": "External url"
                    },
                    {
                    "value": "uploaded",
                    "label": "Uploaded"
                    }
                ]
                },
                {
                "type": "video_url",
                "id": "video_url",
                "accept": ["youtube", "vimeo"],
                "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
                "visible_if": "{{ block.settings.source  == 'external' }}",
                "label": "URL"
                },
                {
                "type": "video",
                "id": "uploaded_video",
                "visible_if": "{{ block.settings.source  == 'uploaded' }}",
                "label": "Video"
                },
                {
                "type": "image_picker",
                "id": "cover_image",
                "visible_if": "{{ block.settings.source  == 'external' }}",
                "label": "Cover image"
                },
                {
                "type": "header",
                "content": "Video settings",
                },
                {
                "type": "checkbox",
                "id": "enable_autoplay",
                "label": "Autoplay",
                "default": true,
                },
                {
                "type": "checkbox",
                "id": "enable_loop_video",
                "label": "Loop video",
                "visible_if": "{{ block.settings.enable_autoplay  ==  false }}",
                "default": true
                },
                {
                "type": "checkbox",
                "id": "enable_mute_video",
                "label": "Mute video",
                "visible_if": "{{ block.settings.enable_autoplay  ==  false  }}",
                "default": true
                },
                {
                "type": "select",
                "id": "play_button_display",
                "label": "Play button display",
                "default": "always",
                "visible_if": "{{ block.settings.enable_video  == true  }}",
                "options": [

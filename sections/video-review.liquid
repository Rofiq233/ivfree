                    "value": "on-hover"
                    },
                    {
                    "label": "Always",
                    "value": "always"
                    }
                ]
                },
                {
                "type": "select",
                "id": "play_button_style",
                "label": "Play button style",
                "default": "default",
                "options": [
                    {
                    "label": "Primary",
                    "value": "primary"
                    },
                    {
                    "label": "Secondary",
                    "value": "secondary"
                    },
                    {
                    "label": "Default",
                    "value": "default"
                    },
                    {
                    "label": "None",
                    "value": "none"
                    }
                ]
                },
                {
                "type": "select",
                "id": "play_button_alignment",
                "label": "Play button alignment",
                "default": "top-right",
                "options": [
                    {
                    "label": "Top Left",
                    "value": "top-left"
                    },
                    {
                    "label": "Center",
                    "value": "center"
                    },
                    {
                    "label": "Top right",
                    "value": "top-right"
                    }
                ]
                },
            ]
        }
    ],
    "presets": [
      {
        "name": "Video review",
        "settings": {
        }
      }
    ]
  }
{% endschema %}
{{- 'section-gallery.css' | asset_url | stylesheet_tag -}}

{%- liquid
 assign section_settings = section.settings


  assign desktop_grid = section_settings.desktop_grid
  assign tab_grid = section_settings.tab_grid
  assign mobile_grid = section_settings.mobile_grid


  assign scrollbar = section_settings.scrollbar
  assign enable_navigation = section_settings.enable_navigation 

  assign loop = section_settings.loop_enabled
  assign autoplay = section_settings.autoplay_enabled
  assign delay = section_settings.autoplay_timeout | times: 1000
-%}

{% capture data_config %}
data-option='{
  "desktopSlider": true,
  "spaceBetween": 0,
  "centeredSlides": false,
  "loop": {{ loop }},
  "speed": 700,
  "freeMode": false,

  "autoplay": {
    "enabled": {{ autoplay }},
    "delay": {{ delay }},
    "disableOnInteraction": false
  },

  "breakpoints": {
    "300": {
      "slidesPerView": {{ mobile_grid }},
      "spaceBetween": 0
    },
    "750": {
      "slidesPerView": {{ tab_grid }},
      "spaceBetween": 0
    },
    "1200": {
      "slidesPerView": {{ desktop_grid }},
      "spaceBetween": 0
    }
  }

  {% if enable_navigation %}
    ,
    "navigation": {
      "nextEl": ".swiper-button-next",
      "prevEl": ".swiper-button-prev"
    }
  {% endif %}

  {% if scrollbar %}
    ,
    "scrollbar": {
      "el": ".swiper-scrollbar",
      "hide": false
    }
  {% endif %}
}'
{% endcapture %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top}}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}


<div
  class="gallery-sectio gradient color-{{ section.settings.section_color_scheme }} section-{{ section.id }}-padding"
  role="region"
  aria-label="gallery Section" 
> 
  <div class="page-width">
{%- if section.settings.heading != blank -%}
    <div class="section-heading">
        <h3 class="{{ section.settings.heading_size }}">{{  section.settings.heading }}</h3>
    </div>
    
{%- endif -%}


    <slideshow-swiper>
      <div class="gallery-card-wrap swiper slideshow__swiper" {{ data_config }}>
        <div
          class="swiper-wrapper"
       >  
            {% for block in section.blocks %}
               {%- liquid
                 
                
                    assign section_settings = block.settings
                    assign source = section_settings.source
                    assign video_url = section_settings.video_url

                    assign uploaded_video = section_settings.uploaded_video

                    assign cover_image = section_settings.cover_image

                    if uploaded_video != blank and source == 'uploaded'
                        assign cover_image = uploaded_video.preview_image
                    endif

                    assign autoplay = section_settings.enable_autoplay
                    assign loop = section_settings.enable_loop_video | default: false
                    assign muted = section_settings.enable_video_mute



                    assign video_type = video_url.type | default: 'local_video'
                    if source == 'uploaded'
                        assign video_type = 'local_video'
                    endif 
               -%}
                <div class="gallery-card swiper-slide">
                    {% render 'video',
                        video_type: video_type
                        source: source,
                        video_url: video_url,
                        uploaded_video: uploaded_video,
                        cover_image: cover_image,
                        autoplay: autoplay,
                        muted: muted,
                        loop: loop,
                        uniq_id: section.id,
                        class:"text-with-video_video"
                        %}
                </div>
                
            {% endfor %}


        </div>
        <div class="gallery-controll_wrap">
           <button class="swiper-button-prev swiper-navigation-btn arrow-prev-button swiper-button-disabled" tabindex="0"
                  aria-label="Previous slide"
                   aria-controls="instagram-slider-{{ section.id }}">
                       {% render 'icons' icon:'button-arrow', width: '14', height: '14' %}
             </button>
          {% if scrollbar %}
            <div class="swiper-scrollbar"></div>
            
          {% endif %}
          <button 
                                  class="swiper-button-next swiper-navigation-btn arrow-next-button"
                                  tabindex="0"
                                    aria-controls="instagram-slider-{{ section.id }}"
                                  aria-label="Next slide"
                                  type="button"
                                >
                                   {% render 'icons' icon:'button-arrow', width: '14', height: '14' %}
                                </button>
        </div>
      </div>
    </slideshow-swiper>
  </div>
</div>
  



{% schema %}
  {
    "name": "Video review",
    "tag": "section",
    "class": "video_review",
    "settings": [

        {
            "type": "inline_richtext",
            "id": "heading",
            "label": "Heading"

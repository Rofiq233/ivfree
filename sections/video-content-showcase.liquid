{{ 'video-content-showcase.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings 
-%}
<section
  class="video-content-showcase section-{{ section.id }}"
  data-video-showcase
  data-section-id="{{ section.id }}"
  style="
    --section-overlay: {{ section.settings.overlay_color }};
    --section-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --section-radius: {{ section.settings.border_radius }}px;
    --section-min-height: {{ section.settings.min_height }}px;
    --content-max-width: {{ section.settings.content_max_width }}px;
  "
>


  <div class="video-content-showcase__background">

    {% if section.settings.background_video != blank %}

      {{
        section.settings.background_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'video-content-showcase__video'
      }}

    {% elsif section.settings.background_image != blank %}

      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          class: 'video-content-showcase__fallback-image',
          alt: section.settings.background_image.alt
      }}

    {% endif %}

    <div class="video-content-showcase__overlay"></div>

  </div>

  <div class="video-content-showcase__container gradient color-{{ section.settings.section_color_scheme }}">

    <div class="video-content-showcase__content {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

      {% if section.settings.eyebrow != blank %}
        <div class="video-content-showcase__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2 class="video-content-showcase__heading {{ s.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      {% if section.settings.description != blank %}
        <div class="video-content-showcase__description rte {{ s.text_style }}">
          {{ section.settings.description }}
        </div>
      {% endif %}


      {% comment %}
        ========================================================
        LINK BLOCKS
        ========================================================
      {% endcomment %}

      {% assign link_blocks = section.blocks | where: 'type', 'content_link' %}

      {% if link_blocks.size > 0 %}

        <div class="video-content-showcase__links {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

          {% for block in link_blocks %}

            <div
              class="video-content-showcase__link-item"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.link != blank %}

                <a
                  href="{{ block.settings.link }}"
                  class="video-content-showcase__link"
                  {% if block.settings.open_new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                >
                  {{ block.settings.link_text }}

                  {% if block.settings.show_arrow %}
                    <span class="video-content-showcase__arrow">
                      →
                    </span>
                  {% endif %}
                </a>

              {% else %}

                <span class="video-content-showcase__link">
                  {{ block.settings.link_text }}

                  {% if block.settings.show_arrow %}
                    <span class="video-content-showcase__arrow">
                      →
                    </span>
                  {% endif %}
                </span>

              {% endif %}

            </div>

          {% endfor %}

        </div>

      {% endif %}

    </div>


    {% comment %}
      ==========================================================
      CERTIFICATION / FEATURE BLOCKS
      ==========================================================
    {% endcomment %}

    {% assign certification_blocks = section.blocks | where: 'type', 'certification' %}

    {% if certification_blocks.size > 0 %}

      <div class="video-content-showcase__certifications {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

        {% for block in certification_blocks %}

          <div
            class="video-content-showcase__certification"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.icon != blank %}

              <div class="video-content-showcase__certification-icon">

                {{
                  block.settings.icon
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    widths: '60,80,100,120,160,200',
                    sizes: '80px',
                    class: 'video-content-showcase__icon',
                    alt: block.settings.title
                }}

              </div>

            {% endif %}


            {% if block.settings.title != blank %}

              <div class="video-content-showcase__certification-title">
                {{ block.settings.title }}
              </div>

            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>

<script src="{{ 'video-content-showcase.js' | asset_url }}" defer></script>


{% schema %}

{
  "name": "Video Content Showcase",
  "tag": "section",
  "class": "section-video-content-showcase",

  "settings": [

    {
      "type": "header",
      "content": "Background"
    },

    {
      "type": "video",
      "id": "background_video",
      "label": "Background video"
    },

    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Fallback image"
    },

    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#1557B0"
    },

    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CERTIFICATIONS"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We Prioritise Safety And Quality."
    },
     {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every batch of our products is third-party tested for purity and potency by globally recognized labs.</p>"
    },
    {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.image-with-text.blocks.text.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.image-with-text.blocks.text.settings.text_style.options__2.label"
            }
          ],
          "default": "body",
          "label": "t:sections.image-with-text.blocks.text.settings.text_style.label"
        },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 680
    },

    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 700
    },

    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
       {
              "type": "color_scheme",
              "id": "section_color_scheme",
              "label": "Scheme"
            }
  ],

  "blocks": [

    {
      "type": "content_link",
      "name": "Content link",

      "settings": [

        {
          "type": "inline_richtext",
          "id": "link_text",
          "label": "Link text",
          "default": "Click here to view more"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show arrow",
          "default": true
        }

      ]

    },

    {
      "type": "certification",
      "name": "Certification / Feature",

      "settings": [

        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon / Logo"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "ISO CERTIFIED"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "Video Content Showcase",

      "blocks": [

        {
          "type": "content_link"
        },

        {
          "type": "content_link"
        },

        {
          "type": "certification"
        },

        {
          "type": "certification"
        },

        {
          "type": "certification"
        },

        {
          "type": "certification"
        },

        {
          "type": "certification"
        },

        {
          "type": "certification"
        }

      ]

    }

  ]

}

{% endschema %}
{{ 'scroll-stat-cards.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'scroll-stat-cards.js' | asset_url }}"
  defer="defer"
></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top}}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="ScrollStatCards-{{ section.id }}"
  class="scroll-stat-cards gradient color-{{ section.settings.section_color_scheme }} section-{{ section.id }}-padding"
  data-scroll-stat-section
  data-section-id="{{ section.id }}"
  style="
    --scroll-stat-card-gap: {{ section.settings.card_gap }}px;
    --scroll-stat-card-radius: {{ section.settings.card_radius }}px;
    --scroll-stat-card-padding: {{ section.settings.card_padding }}px;
    --scroll-stat-row-height: {{ section.settings.row_height }}px;

    --scroll-stat-button-background: {{ section.settings.button_background }};
    --scroll-stat-button-color: {{ section.settings.button_color }};
  "
>


  <div class="scroll-stat-cards__container page-width">


    <!-- =====================================================
         LEFT CONTENT
    ====================================================== -->

    <div class="scroll-stat-cards__left {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">


      {% if section.settings.eyebrow != blank %}

        <div class="scroll-stat-cards__eyebrow">
          {{ section.settings.eyebrow }}
        </div>

      {% endif %}


      {% if section.settings.heading != blank %}

        <h2 class="scroll-stat-cards__heading {{ section.settings.heading_sizes }}">
          {{ section.settings.heading }}
        </h2>

      {% endif %}


      {% if section.settings.description != blank %}

        <div class="scroll-stat-cards__description rte {{ section.settings.text_style }}">
          {{ section.settings.description }}
        </div>

      {% endif %}


      {% if section.settings.btn != blank %}

        <a
          class="scroll-stat-cards__button button button--{{ section.settings.button_style }}"
          href="{{ section.settings.url | default: '#' }}"
        >

          <span>
            {{ section.settings.btn }}
          </span>

          <span
            class="scroll-stat-cards__button-icon"
            aria-hidden="true"
          >
            {% render 'icons' icon:'button-arrow', width: '16', height: '16', class: 'icon-arrow' %}
          </span>

        </a>

      {% endif %}


    </div>



    <!-- =====================================================
         RIGHT STICKY CARD AREA
    ====================================================== -->

    <div class="scroll-stat-cards__right">

      <div class="scroll-stat-cards__sticky">

        <div class="scroll-stat-cards__grid">


          {% for block in section.blocks %}


            {% assign has_image = false %}

            {% if block.settings.image != blank %}
              {% assign has_image = true %}
            {% endif %}


            <article
              class="
                scroll-stat-card {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}
                scroll-stat-card--{{ block.settings.card_width }}
                scroll-stat-card--{{ block.settings.card_height }}

                {% if has_image %}
                  scroll-stat-card--has-image
                {% endif %}
              "

              data-stat-card

              {{ block.shopify_attributes }}

              style="
                --card-bg: {{ block.settings.background_color }};
                --card-color: {{ block.settings.text_color }};
              "
            >


              <!-- =================================================
                   IMAGE
              ================================================== -->

              {% if block.settings.image != blank %}

                <div class="scroll-stat-card__media">

                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200, 1600',
                      sizes: '(min-width: 990px) 45vw, 100vw',
                      class: 'scroll-stat-card__image'
                  }}

                </div>

              {% endif %}



              <!-- =================================================
                   GRADIENT
              ================================================== -->

              {% if block.settings.image != blank %}

                <div class="scroll-stat-card__gradient"></div>

              {% endif %}



              <!-- =================================================
                   CONTENT
              ================================================== -->

              <div class="scroll-stat-card__content">


                {% if block.settings.badge != blank %}

                  <div class="scroll-stat-card__badge">
                    {{ block.settings.badge }}
                  </div>

                {% endif %}



                <div class="scroll-stat-card__bottom">


                  {% if block.settings.stat_value != blank %}

                    <div
                      class="scroll-stat-card__stat"
                      data-counter
                      data-target="{{ block.settings.stat_value }}"
                      data-prefix="{{ block.settings.stat_prefix }}"
                      data-suffix="{{ block.settings.stat_suffix }}"
                    >
                      {{ block.settings.stat_prefix }}0{{ block.settings.stat_suffix }}
                    </div>

                  {% endif %}



                  {% if block.settings.description != blank %}

                    <div class="scroll-stat-card__text">
                      {{ block.settings.description }}
                    </div>

                  {% endif %}


                </div>


              </div>


            </article>


          {% endfor %}


        </div>

      </div>

    </div>


  </div>


</section>



{% schema %}


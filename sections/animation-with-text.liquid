




{{ 'capsule-thesis.css' | asset_url | stylesheet_tag }}

{% comment %} <section
  id="CapsuleThesis-{{ section.id }}"
  class="capsule-thesis"
  style="
    --capsule-bg: {{ section.settings.background_color }};
    --capsule-text: {{ section.settings.text_color }};
    --heading-size: {{ section.settings.heading_size }}px;
    --capsule-width: {{ section.settings.capsule_width }}px;
  "
>

  <div class="capsule-thesis__sticky">

    <div class="capsule-thesis__container">

      <!-- =========================================
           LEFT CONTENT
      ========================================== -->

      <div class="capsule-thesis__content">

        {% if section.settings.eyebrow != blank %}
          <p class="capsule-thesis__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}


        {% if section.settings.heading != blank %}
          <h2 class="capsule-thesis__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}


        {% if section.settings.description != blank %}
          <div class="capsule-thesis__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

      </div>


      <!-- =========================================
           CAPSULE VISUAL
      ========================================== -->

      <div class="capsule-thesis__visual">

        <div
          class="capsule-animation"

          data-top-x="{{ section.settings.top_x }}"
          data-top-y="{{ section.settings.top_y }}"
          data-top-rotation="{{ section.settings.top_rotation }}"

          data-middle-one-x="{{ section.settings.middle_one_x }}"
          data-middle-one-y="{{ section.settings.middle_one_y }}"
          data-middle-one-rotation="{{ section.settings.middle_one_rotation }}"

          data-middle-two-x="{{ section.settings.middle_two_x }}"
          data-middle-two-y="{{ section.settings.middle_two_y }}"
          data-middle-two-rotation="{{ section.settings.middle_two_rotation }}"

          data-bottom-x="{{ section.settings.bottom_x }}"
          data-bottom-y="{{ section.settings.bottom_y }}"
          data-bottom-rotation="{{ section.settings.bottom_rotation }}"
        >

          <!-- TOP PIECE -->

          {% if section.settings.top_svg != blank %}

            <div class="capsule-piece capsule-piece--top">

              {{
                section.settings.top_svg
                | image_url: width: 1000
                | image_tag:
                  loading: 'eager',
                  alt: ''
              }}

            </div>

          {% endif %}


          <!-- MIDDLE ONE -->

          {% if section.settings.middle_one_svg != blank %}

            <div class="capsule-piece capsule-piece--middle-one">

              {{
                section.settings.middle_one_svg
                | image_url: width: 1000
                | image_tag:
                  loading: 'eager',
                  alt: ''
              }}

            </div>

          {% endif %}


          <!-- MIDDLE TWO -->

          {% if section.settings.middle_two_svg != blank %}

            <div class="capsule-piece capsule-piece--middle-two">

              {{
                section.settings.middle_two_svg
                | image_url: width: 1000
                | image_tag:
                  loading: 'eager',
                  alt: ''
              }}

            </div>

          {% endif %}


          <!-- BOTTOM PIECE -->

          {% if section.settings.bottom_svg != blank %}

            <div class="capsule-piece capsule-piece--bottom">

              {{
                section.settings.bottom_svg
                | image_url: width: 1000
                | image_tag:
                  loading: 'eager',
                  alt: ''
              }}

            </div>

          {% endif %}

        </div>

      </div>

    </div>

  </div>

</section>  

<script
  src="{{ 'capsule-thesis.js' | asset_url }}"
  defer
></script> {% endcomment %}



<section
  id="CapsuleThesis-{{ section.id }}"
  class="capsule-thesis"
  style="
    --capsule-bg: {{ section.settings.background_color }};
    --capsule-text: {{ section.settings.text_color }};
    --heading-size: {{ section.settings.heading_size }}px;
    --capsule-width: {{ section.settings.capsule_width }}px;
  "
>

  <div class="capsule-thesis__sticky">

 <div class="capsule-thesis__container">

  <!-- LEFT CONTENT -->

  <div class="capsule-thesis__content">

    {% if section.settings.eyebrow != blank %}
      <p class="capsule-thesis__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="capsule-thesis__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="capsule-thesis__description">
        {{ section.settings.description }}
      </div>
    {% endif %}

  </div>


  <!-- CAPSULE -->

  <div class="capsule-thesis__visual">

    <div
      class="capsule-animation"

      data-top-x="{{ section.settings.top_x }}"
      data-top-y="{{ section.settings.top_y }}"
      data-top-rotation="{{ section.settings.top_rotation }}"

      data-middle-one-x="{{ section.settings.middle_one_x }}"
      data-middle-one-y="{{ section.settings.middle_one_y }}"
      data-middle-one-rotation="{{ section.settings.middle_one_rotation }}"

      data-middle-two-x="{{ section.settings.middle_two_x }}"
      data-middle-two-y="{{ section.settings.middle_two_y }}"
      data-middle-two-rotation="{{ section.settings.middle_two_rotation }}"

      data-bottom-x="{{ section.settings.bottom_x }}"
      data-bottom-y="{{ section.settings.bottom_y }}"
      data-bottom-rotation="{{ section.settings.bottom_rotation }}"
    >

      {% if section.settings.top_svg != blank %}
        {{
          section.settings.top_svg
          | image_url: width: 1000
          | image_tag:
            class: 'capsule-piece capsule-piece--top',
            loading: 'eager',
            alt: ''
        }}
      {% endif %}


      {% if section.settings.middle_one_svg != blank %}
        {{
          section.settings.middle_one_svg
          | image_url: width: 1000
          | image_tag:
            class: 'capsule-piece capsule-piece--middle-one',
            loading: 'eager',
            alt: ''
        }}
      {% endif %}


      {% if section.settings.middle_two_svg != blank %}
        {{
          section.settings.middle_two_svg
          | image_url: width: 1000
          | image_tag:
            class: 'capsule-piece capsule-piece--middle-two',
            loading: 'eager',
            alt: ''
        }}
      {% endif %}


      {% if section.settings.bottom_svg != blank %}
        {{
          section.settings.bottom_svg
          | image_url: width: 1000
          | image_tag:
            class: 'capsule-piece capsule-piece--bottom',
            loading: 'eager',
            alt: ''
        }}
      {% endif %}

    </div>

  </div>

</div>

  </div>

</section>
<script
  src="{{ 'capsule-thesis.js' | asset_url }}"
  defer
></script>

{% schema %}
{
  "name": "Capsule Thesis",
  "tag": "section",
  "class": "section-capsule-thesis",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT IS THESIS?"
    },

    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Nootropic formulas that enhance cognitive function to help your brain perform at its best."
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },


    {
      "type": "header",
      "content": "Design"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5F5F0"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 30,
      "max": 100,
      "step": 2,
      "default": 64,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "capsule_width",
      "label": "Capsule Width",
      "min": 150,
      "max": 600,
      "step": 10,
      "default": 260,
      "unit": "px"
    },


    {
      "type": "header",
      "content": "Capsule SVGs"
    },

    {
      "type": "image_picker",
      "id": "top_svg",
      "label": "Top Capsule SVG"
    },

    {
      "type": "image_picker",
      "id": "middle_one_svg",
      "label": "Middle One Capsule SVG"
    },

    {
      "type": "image_picker",
      "id": "middle_two_svg",
      "label": "Middle Two Capsule SVG"
    },

    {
      "type": "image_picker",
      "id": "bottom_svg",
      "label": "Bottom Capsule SVG"
    },


    {
      "type": "header",
      "content": "Top Animation"
    },

    {
      "type": "range",
      "id": "top_x",
      "label": "Top X",
      "min": -300,
      "max": 300,
      "step": 10,
      "default": 80,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "top_y",
      "label": "Top Y",
      "min": -300,
      "max": 300,
      "step": 10,
      "default": -120,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "top_rotation",
      "label": "Top Rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "default": -8,
      "unit": "deg"
    },


    {
      "type": "header",
      "content": "Middle One Animation"
    },

    {
      "type": "range",
      "id": "middle_one_x",
      "label": "Middle One X",
      "min": -300,
      "max": 300,
      "step": 10,
      "default": -60,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "middle_one_y",
      "label": "Middle One Y",
      "min": -300,
      "max": 300,
      "step": 10,
      "default": -30,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "middle_one_rotation",
      "label": "Middle One Rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "default": -4,
      "unit": "deg"
    },


    {
      "type": "header",
      "content": "Middle Two Animation"
    },

    {
      "type": "range",
      "id": "middle_two_x",
      "label": "Middle Two X",
      "min": -300,
      "max": 300,
      "step": 10,
      "default": 60,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "middle_two_y",
      "label": "Middle Two Y",
      "min": -300,
      "max": 300,
      "step": 10,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "middle_two_rotation",
      "label": "Middle Two Rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "default": 5,
      "unit": "deg"
    },


    {
      "type": "header",
      "content": "Bottom Animation"
    },

    {
      "type": "range",
      "id": "bottom_x",
      "label": "Bottom X",
      "min": -300,
      "max": 300,
      "step": 10,
      "default": -80,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "bottom_y",
      "label": "Bottom Y",
      "min": -300,
      "max": 300,
      "step": 10,
      "default": 130,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "bottom_rotation",
      "label": "Bottom Rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "default": 8,
      "unit": "deg"
    }

  ],

  "presets": [
    {
      "name": "Capsule Thesis"
    }
  ]
}
{% endschema %}
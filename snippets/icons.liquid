{%- case icon -%}
    {%- when 'button-arrow' -%}
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="currentColor" viewBox="0 0 11 11" style="width:12px;height:12px">
        
        <path fill="var(--fill-brand)" fill-rule="evenodd" d="M5.5 0 11 5.5 5.5 11 4.406 9.906l3.631-3.632H0V4.726h8.037L4.406 1.094 5.5 0Z" clip-rule="evenodd"></path></svg>
    {%- when 'play' -%}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      focusable="false"
      width="{{ width | default: 14 }}"
      height="{{ height | default: 41 }}"
      class="{{ class | strip }}"
      fill="none"
      viewBox="0 0 256 256"
    >
      <path d="M240,128a15.74,15.74,0,0,1-7.6,13.51L88.32,229.65a16,16,0,0,1-16.2.3A15.86,15.86,0,0,1,64,216.13V39.87a15.86,15.86,0,0,1,8.12-13.82,16,16,0,0,1,16.2.3L232.4,114.49A15.74,15.74,0,0,1,240,128Z" fill="currentColor"></path>
    </svg>
    
  {%- when 'pause' -%}
    <svg
      class="{{class}}"
      xmlns="http://www.w3.org/2000/svg"
      width="{{ width | default: 16 }}"
      height="{{ height | default: 16 }}"
      fill="currentColor"
      viewBox="0 0 256 256"
    >
      <path d="M200,28H160a20,20,0,0,0-20,20V208a20,20,0,0,0,20,20h40a20,20,0,0,0,20-20V48A20,20,0,0,0,200,28Zm-4,176H164V52h32ZM96,28H56A20,20,0,0,0,36,48V208a20,20,0,0,0,20,20H96a20,20,0,0,0,20-20V48A20,20,0,0,0,96,28ZM92,204H60V52H92Z">
      </path>
    </svg>
        
    {%- endcase -%} 
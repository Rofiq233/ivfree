\n  }\n\n  @media screen and (max-width: 749px) {\n    .hydrate-marquee__track {\n      animation-duration: 25s;\n    }\n\n    .hydrate-marquee__group {\n      gap: 1.8rem;\n      padding: 1.2rem 0.9rem;\n    }\n\n    .hydrate-marquee span {\n      font-size: 1.2rem;\n    }\n\n    .hydrate-marquee i {\n      flex-basis: 0.55rem;\n      width: 0.55rem;\n      height: 0.55rem;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hydrate-marquee {\n      overflow-x: auto;\n    }\n\n    .hydrate-marquee__track {\n      animation: none;\n    }\n  }\n</style>"

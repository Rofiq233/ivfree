            "custom_liquid": "<div class=\"hydrate-marquee\" aria-label=\"Hydrate product highlights\">\n  <div class=\"hydrate-marquee__track\">\n\n    {% for repeat in (1..4) %}\n      <div class=\"hydrate-marquee__group\" {% if repeat > 1 %}aria-hidden=\"true\"{% endif %}>\n        <span>FORMULATED FOR UP TO 5× ABSORPTION<\/span>\n        <i><\/i>\n\n        <span>4 ESSENTIAL MINERALS<\/span>\n        <i><\/i>\n\n        <span>120 TABLETS<\/span>\n        <i><\/i>\n\n        <span>VEGAN &amp; SUGAR-FREE<\/span>\n        <i><\/i>\n\n        <span>THIRD-PARTY TESTED<\/span>\n        <i><\/i>\n      <\/div>\n    {% endfor %}\n\n  <\/div>\n<\/div>\n\n<style>\n  .hydrate-marquee {\n    --marquee-ink: #14213a;\n    --marquee-accent: #2e8c8c;\n    --marquee-bg: #faf5ec;\n    --marquee-border: #ede6d8;\n\n    position: relative;\n    width: 100%;\n    overflow: hidden;\n    color: var(--marquee-ink);\n    background: var(--marquee-bg);\n    border-top: 1px solid var(--marquee-border);\n    border-bottom: 1px solid var(--marquee-border);\n  }\n\n  .hydrate-marquee__track {\n    display: flex;\n    width: max-content;\n    animation: hydrate-marquee-scroll 35s linear infinite;\n    will-change: transform;\n  }\n\n  .hydrate-marquee__group {\n    display: flex;\n    flex-shrink: 0;\n    align-items: center;\n    gap: 2.6rem;\n    min-width: max-content;\n    padding: 1.4rem 1.3rem;\n  }\n\n  .hydrate-marquee span {\n    color: var(--marquee-ink);\n    font-size: 1.45rem;\n    font-weight: 600;\n    line-height: 1;\n    letter-spacing: 0.025em;\n    white-space: nowrap;\n  }\n\n  .hydrate-marquee i {\n    display: block;\n    flex: 0 0 0.7rem;\n    width: 0.7rem;\n    height: 0.7rem;\n    background: var(--marquee-accent);\n    border-radius: 0;\n  }\n\n  .hydrate-marquee:hover .hydrate-marquee__track {\n    animation-play-state: paused;\n  }\n\n  @keyframes hydrate-marquee-scroll {\n    from {\n      transform: translateX(0);\n    }\n\n    to {\n      transform: translateX(-25%);\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .hydrate-marquee__track {\n      animation-duration: 25s;\n    }\n\n    .hydrate-marquee__group {\n      gap: 1.8rem;\n      padding: 1.2rem 0.9rem;\n    }\n\n    .hydrate-marquee span {\n      font-size: 1.2rem;\n    }\n\n    .hydrate-marquee i {\n      flex-basis: 0.55rem;\n      width: 0.55rem;\n      height: 0.55rem;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hydrate-marquee {\n      overflow-x: auto;\n    }\n\n    .hydrate-marquee__track {\n      animation: none;\n    }\n  }\n<\/style>"

        "custom_liquid_nBxTDA": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign hydrate_discount_code = 'HYDRATE7' %}\n{% assign hydrate_discount_amount = '7%' %}\n\n<div\n  class=\"hydrate-discount\"\n  id=\"hydrate-discount-{{ product.id }}\"\n  data-discount-code=\"{{ hydrate_discount_code }}\"\n>\n  <div class=\"hydrate-discount__message\">\n    <span class=\"hydrate-discount__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" role=\"img\">\n        <path d=\"M12 2.5 14.2 5l3.3-.3.8 3.2 3 1.4-1.4 3 1.4 3-3 1.4-.8 3.2-3.3-.3L12 22l-2.2-2.5-3.3.3-.8-3.2-3-1.4 1.4-3-1.4-3 3-1.4.8-3.2 3.3.3L12 2.5Z\"\/>\n        <path d=\"m8.5 15.5 7-7M9 9h.01M15 15h.01\"\/>\n      <\/svg>\n    <\/span>\n\n    <span>\n      Get flat <strong>{{ hydrate_discount_amount }} off<\/strong> on your order.\n    <\/span>\n  <\/div>\n\n  <button\n    class=\"hydrate-discount__code\"\n    type=\"button\"\n    aria-label=\"Copy discount code {{ hydrate_discount_code }}\"\n  >\n    <span>Use code:<\/span>\n    <strong>{{ hydrate_discount_code }}<\/strong>\n\n    <svg class=\"hydrate-discount__copy-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <rect x=\"8\" y=\"8\" width=\"11\" height=\"13\" rx=\"1.5\"><\/rect>\n      <path d=\"M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h3\"><\/path>\n    <\/svg>\n\n    <span class=\"hydrate-discount__feedback\" aria-live=\"polite\"><\/span>\n  <\/button>\n<\/div>\n\n<style>\n  #hydrate-discount-{{ product.id }} {\n    --discount-ink: #14213a;\n    --discount-accent: #2e8c8c;\n    --discount-background: #e2f0ee;\n    --discount-divider: rgba(20, 33, 58, 0.12);\n\n    display: grid;\n    grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);\n    width: 100%;\n    margin: 1.8rem 0;\n    overflow: hidden;\n    color: var(--discount-ink);\n    background: var(--discount-background);\n    border: 1px solid var(--discount-divider);\n    border-radius: 0.8rem;\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__message {\n    display: flex;\n    align-items: center;\n    gap: 1.2rem;\n    min-width: 0;\n    padding: 1.5rem 1.7rem;\n    font-size: 1.55rem;\n    line-height: 1.3;\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__icon {\n    display: inline-flex;\n    flex: 0 0 3rem;\n    width: 3rem;\n    height: 3rem;\n    align-items: center;\n    justify-content: center;\n    color: #fff;\n    background: var(--discount-accent);\n    border-radius: 50%;\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__icon svg {\n    width: 2rem;\n    height: 2rem;\n    fill: currentColor;\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__icon svg path:last-child {\n    fill: none;\n    stroke: var(--discount-accent);\n    stroke-linecap: round;\n    stroke-width: 1.8;\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__code {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 0.6rem;\n    min-width: 0;\n    padding: 1.5rem;\n    color: var(--discount-ink);\n    background: transparent;\n    border: 0;\n    border-left: 1px solid var(--discount-divider);\n    border-radius: 0;\n    box-shadow: none;\n    font: inherit;\n    font-size: 1.45rem;\n    cursor: pointer;\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__code:hover {\n    background: rgba(46, 140, 140, 0.09);\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__code strong {\n    color: var(--discount-accent);\n    font-weight: 700;\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__copy-icon {\n    width: 1.8rem;\n    height: 1.8rem;\n    fill: none;\n    stroke: var(--discount-accent);\n    stroke-width: 1.8;\n  }\n\n  #hydrate-discount-{{ product.id }} .hydrate-discount__feedback {\n    position: absolute;\n    right: 0.8rem;\n    bottom: 0.25rem;\n    color: var(--discount-accent);\n    font-size: 1rem;\n  }\n\n  @media screen and (max-width: 749px) {\n    #hydrate-discount-{{ product.id }} {\n      grid-template-columns: 1fr;\n    }\n\n    #hydrate-discount-{{ product.id }} .hydrate-discount__message,\n    #hydrate-discount-{{ product.id }} .hydrate-discount__code {\n      justify-content: flex-start;\n      padding: 1.3rem 1.4rem;\n    }\n\n    #hydrate-discount-{{ product.id }} .hydrate-discount__code {\n      border-top: 1px solid var(--discount-divider);\n      border-left: 0;\n    }\n  }\n<\/style>\n\n<script>\n  (() => {\n    const banner = document.getElementById(\n      'hydrate-discount-{{ product.id }}'\n    );\n\n    if (!banner || banner.dataset.initialized === 'true') return;\n\n    banner.dataset.initialized = 'true';\n\n    const button = banner.querySelector('.hydrate-discount__code');\n    const feedback = banner.querySelector('.hydrate-discount__feedback');\n    const code = banner.dataset.discountCode;\n\n    button.addEventListener('click', async () => {\n      try {\n        await navigator.clipboard.writeText(code);\n        feedback.textContent = 'Copied!';\n      } catch (error) {\n        const input = document.createElement('input');\n        input.value = code;\n        document.body.appendChild(input);\n        input.select();\n        document.execCommand('copy');\n        input.remove();\n        feedback.textContent = 'Copied!';\n      }\n\n      window.setTimeout(() => {\n        feedback.textContent = '';\n      }, 1800);\n    });\n  })();\n<\/script>"
          }
        },

        "custom_liquid_txzejx": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% liquid\n  assign rating_data = product.metafields.reviews.rating.value\n  assign rating_count = product.metafields.reviews.rating_count.value | default: 0\n\n  if rating_data\n    assign rating_value = rating_data.rating | default: rating_data\n    assign rating_max = rating_data.scale_max | default: 5\n  endif\n%}\n\n<div class=\"hydrate-proof\">\n  <div class=\"hydrate-proof__top\">\n\n    <div class=\"hydrate-proof__summary\">\n      <strong class=\"hydrate-proof__number\">4<\/strong>\n\n      <div class=\"hydrate-proof__summary-text\">\n        <strong>Essential Minerals<\/strong>\n        <span>One daily tablet<\/span>\n      <\/div>\n    <\/div>\n\n    <div class=\"hydrate-proof__rating\">\n      {% if rating_value != blank and rating_count > 0 %}\n        <div\n          class=\"hydrate-stars\"\n          style=\"--rating: {{ rating_value }};\"\n          role=\"img\"\n          aria-label=\"{{ rating_value }} out of {{ rating_max }} stars\"\n        >\n          <span aria-hidden=\"true\">★★★★★<\/span>\n        <\/div>\n\n        <div class=\"hydrate-proof__rating-meta\">\n          <strong>{{ rating_value | round: 1 }}<\/strong>\n\n          <span class=\"hydrate-proof__rating-divider\"><\/span>\n\n          <a href=\"#judgeme_product_reviews\">\n            {{ rating_count }}\n            {% if rating_count == 1 %}\n              review\n            {% else %}\n              reviews\n            {% endif %}\n          <\/a>\n        <\/div>\n      {% else %}\n        <div class=\"hydrate-proof__trust\">\n          <strong>Third-party tested<\/strong>\n          <span>Quality you can trust<\/span>\n        <\/div>\n      {% endif %}\n    <\/div>\n\n  <\/div>\n\n  <div class=\"hydrate-proof__benefits\">\n    <h3>Why Hydrate?<\/h3>\n\n    <div class=\"hydrate-proof__grid\">\n      <div class=\"hydrate-proof__item\">\n        <span class=\"hydrate-check\" aria-hidden=\"true\">✓<\/span>\n        <span>Daily electrolyte support<\/span>\n      <\/div>\n\n      <div class=\"hydrate-proof__item\">\n        <span class=\"hydrate-check\" aria-hidden=\"true\">✓<\/span>\n        <span>Magnesium + potassium<\/span>\n      <\/div>\n\n      <div class=\"hydrate-proof__item\">\n        <span class=\"hydrate-check\" aria-hidden=\"true\">✓<\/span>\n        <span>Sodium + zinc<\/span>\n      <\/div>\n\n      <div class=\"hydrate-proof__item\">\n        <span class=\"hydrate-check\" aria-hidden=\"true\">✓<\/span>\n        <span>Vegan and sugar-free<\/span>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n  .hydrate-proof {\n    --hydrate-ink: #14213a;\n    --hydrate-cream: #faf5ec;\n    --hydrate-surface: #ffffff;\n    --hydrate-bone: #ede6d8;\n    --hydrate-accent: #2e8c8c;\n\n    width: 100%;\n    margin: 20px 0;\n    color: var(--hydrate-ink);\n    background: var(--hydrate-cream);\n    border-top: 1px solid var(--hydrate-bone);\n    border-bottom: 1px solid var(--hydrate-bone);\n    font-family: inherit;\n  }\n\n  .hydrate-proof *,\n  .hydrate-proof *::before,\n  .hydrate-proof *::after {\n    box-sizing: border-box;\n  }\n\n  \/* Top row *\/\n\n  .hydrate-proof__top {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);\n    align-items: center;\n    gap: 24px;\n    padding: 24px 0;\n  }\n\n  .hydrate-proof__summary {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    min-width: 0;\n    padding-right: 24px;\n    border-right: 1px solid var(--hydrate-bone);\n  }\n\n  .hydrate-proof__number {\n    flex: 0 0 auto;\n    color: var(--hydrate-accent);\n    font-size: 56px;\n    font-weight: 700;\n    line-height: 0.9;\n    letter-spacing: -0.05em;\n  }\n\n  .hydrate-proof__summary-text {\n    display: flex;\n    min-width: 0;\n    flex-direction: column;\n    color: var(--hydrate-ink);\n    font-size: 16px;\n    line-height: 1.3;\n  }\n\n  .hydrate-proof__summary-text strong {\n    font-weight: 700;\n  }\n\n  .hydrate-proof__summary-text span {\n    margin-top: 3px;\n    color: rgba(20, 33, 58, 0.7);\n    font-size: 14px;\n  }\n\n  \/* Trust fallback *\/\n\n  .hydrate-proof__rating {\n    min-width: 0;\n  }\n\n  .hydrate-proof__trust {\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n  }\n\n  .hydrate-proof__trust strong {\n    color: var(--hydrate-accent);\n    font-size: 17px;\n    font-weight: 700;\n    line-height: 1.3;\n  }\n\n  .hydrate-proof__trust span {\n    color: rgba(20, 33, 58, 0.7);\n    font-size: 14px;\n    line-height: 1.3;\n  }\n\n  \/* Dynamic review rating *\/\n\n  .hydrate-stars {\n    --percent: calc(var(--rating) \/ 5 * 100%);\n\n    position: relative;\n    display: inline-block;\n    font-size: 27px;\n    line-height: 1;\n    letter-spacing: 1px;\n  }\n\n  .hydrate-stars span {\n    color: var(--hydrate-bone);\n  }\n\n  .hydrate-stars::before {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: var(--percent);\n    overflow: hidden;\n    color: var(--hydrate-accent);\n    content: \"★★★★★\";\n    white-space: nowrap;\n  }\n\n  .hydrate-proof__rating-meta {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    margin-top: 7px;\n    color: var(--hydrate-ink);\n    font-size: 15px;\n  }\n\n  .hydrate-proof__rating-meta a {\n    color: var(--hydrate-ink);\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .hydrate-proof__rating-divider {\n    width: 1px;\n    height: 18px;\n    background: var(--hydrate-bone);\n  }\n\n  \/* Benefit area *\/\n\n  .hydrate-proof__benefits {\n    padding: 22px 0 24px;\n    border-top: 1px solid var(--hydrate-bone);\n  }\n\n  .hydrate-proof__benefits h3 {\n    margin: 0 0 16px;\n    color: var(--hydrate-ink);\n    font-family: inherit;\n    font-size: 19px;\n    font-weight: 700;\n    line-height: 1.3;\n  }\n\n  .hydrate-proof__grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 14px 24px;\n  }\n\n  .hydrate-proof__item {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-width: 0;\n    color: var(--hydrate-ink);\n    font-size: 15px;\n    line-height: 1.35;\n  }\n\n  .hydrate-check {\n    display: inline-flex;\n    flex: 0 0 25px;\n    width: 25px;\n    height: 25px;\n    align-items: center;\n    justify-content: center;\n    color: var(--hydrate-surface);\n    background: var(--hydrate-accent);\n    border-radius: 50%;\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  \/* Mobile *\/\n\n  @media screen and (max-width: 749px) {\n  .hydrate-proof__number {\n    font-size: 36px;\n  }\n\n  .hydrate-proof__summary-text {\n    font-size: 15px;\n    line-height: 1.25;\n  }\n\n  .hydrate-proof__trust strong {\n    font-size: 15px;\n    line-height: 1.25;\n  }\n\n  .hydrate-proof__benefits h3 {\n    margin-bottom: 16px;\n    font-size: 21px;\n    line-height: 1.25;\n  }\n\n  .hydrate-proof__grid {\n    gap: 14px 16px;\n  }\n\n  .hydrate-proof__item {\n    gap: 8px;\n    font-size: 14px;\n    line-height: 1.35;\n  }\n\n  .hydrate-check {\n    flex: 0 0 23px;\n    width: 23px;\n    height: 23px;\n    font-size: 13px;\n  }\n}\n\n@media screen and (max-width: 380px) {\n  .hydrate-proof__number {\n    font-size: 31px;\n  }\n\n  .hydrate-proof__summary-text,\n  .hydrate-proof__trust strong {\n    font-size: 13px;\n  }\n\n  .hydrate-proof__benefits h3 {\n    font-size: 19px;\n  }\n\n  .hydrate-proof__item {\n    font-size: 12px;\n  }\n\n  .hydrate-check {\n    flex-basis: 21px;\n    width: 21px;\n    height: 21px;\n    font-size: 12px;\n  }\n}"
          }
